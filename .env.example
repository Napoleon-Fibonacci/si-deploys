# Neon Postgres (Vercel Marketplace -> Neon)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Token API Vercel (server only). Buat di https://vercel.com/account/tokens
VERCEL_TOKEN=

# Opsional: isi kalau project berada di dalam team
VERCEL_TEAM_ID=

# Vercel Blob (Vercel Storage -> Blob). Dipakai upload ZIP dari browser.
BLOB_READ_WRITE_TOKEN=

# Batas jumlah project aktif
MAX_PROJECTS=180

# Rahasia cron pembersih. Isi dengan string acak; kalau diisi, Vercel
# menyertakan header Authorization: Bearer <CRON_SECRET> saat memanggil cron.
# Kosong = hanya sesi admin yang boleh memicu /api/cron/cleanup.
CRON_SECRET=

# Sumber kartu social preview (og:image). WhatsApp menyusun preview dari sini.
# Tambahkan kalau memakai domain sendiri atau memakai HTTPS kustom.
# Kalau kosong, URL dikutip dari domain produksi Vercel, atau localhost saat dev.
NEXT_PUBLIC_SITE_URL=

# Password menu admin (/admin). Kosong = menu admin nonaktif.
ADMIN_PASSWORD=
